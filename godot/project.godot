; Aquarius cabin prototype with shared-clock electrical and native AGC integration.
config_version=5

[application]
config/name="Aquarius - LM-7 Cabin Study"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.024, 0.051, 0.086, 1)

[dotnet]
project/assembly_name="Aquarius"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.004, 0.008, 0.014, 1)

[xr]
openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true

[debug]
gdscript/warnings/untyped_declaration=0
